+
+struct pt_regs;
+
+/*
+ * Call site is inside do_page_fault(), with mm->mmap_sem held for read and the
+ * faulting task being current.  Observes only: it never claims the fault, so
+ * the normal handling always goes ahead and the access always succeeds.
+ * Costs one perfectly-predicted branch while no watch is armed.
+ */
