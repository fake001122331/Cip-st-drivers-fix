diff --git a/drivers/kdbg/kdbg.h b/drivers/kdbg/kdbg.h
new file mode 100644
--- /dev/null
+++ b/drivers/kdbg/kdbg.h
@@ -0,0 +1,190 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _KDBG_H
+#define _KDBG_H
+
+/*
+ * Shared between the kernel side and the userspace client.
+ *
+ * KDBG_COOKIE is the first argument of every call. Without it the syscall
+ * answers -ENOSYS, so a blind probe of the number sees the same thing it would
+ * see from an unused table slot.
+ */
+#define KDBG_COOKIE	0x9E3779B97F4A7C15ULL
+
+/* KDBG_OP_PING returns this. */
+#define KDBG_MAGIC	0x5032300AUL
+
+enum {
+	KDBG_OP_PING       = 0,	/* -> KDBG_MAGIC				*/
+	KDBG_OP_READ       = 1,	/* a1=pid a2=addr a3=buf a4=len -> bytes	*/
+	KDBG_OP_WRITE      = 2,	/* a1=pid a2=addr a3=buf a4=len -> bytes	*/
+	KDBG_OP_BASE       = 3,	/* a1=pid a2=name a3=&out -> 0		*/
+
+	/*
+	 * Hardware breakpoints.  A breakpoint costs no code change at all:
+	 * nothing is written to the target, so there is no byte to notice and
+	 * nothing that survives a restart of the game.  Four registers is what
+	 * the architecture gives us.
+	 */
+	KDBG_OP_HWBP_SET   = 4,	/* a1=pid a2=addr a3=type a4=len -> slot	*/
+	KDBG_OP_HWBP_DEL   = 5,	/* a1=slot -> 0				*/
+	KDBG_OP_HWBP_STAT  = 6,	/* a1=slot a2=&u64[3] -> 0		*/
+	KDBG_OP_HWBP_ARM   = 7,	/* a1=&struct kdbg_hbp_cfg -> slot		*/
+
+	/*
+	 * Page watches - the fault-path half of a PTE hook.  Arming takes the
+	 * access away from one page in one process; the next time that process
+	 * touches it the kernel records who, from where, and whether it was a
+	 * write, then lets the access through.  The page's own contents are
+	 * never modified, which is the point.
+	 */
+	KDBG_OP_WATCH_ARM  = 8,	/* a1=&struct kdbg_watch_cfg -> slot		*/
+	KDBG_OP_WATCH_STAT = 9,	/* a1=slot a2=&struct kdbg_watch_info -> 0	*/
+	KDBG_OP_WATCH_OFF  = 10,/* a1=slot -> 0				*/
+
+	/*
+	 * Turn the compatibility device nodes on or off at runtime.  They are the
+	 * most visible thing this driver does - a set of /dev entries and
+	 * /sys/class/misc entries that any process can see - so they are OFF
+	 * unless asked for.  Nothing else here is visible at rest.
+	 */
+	KDBG_OP_COMPAT     = 11,/* a1=0 off / 1 on -> nodes registered	*/
+};
+
+/* a3 of KDBG_OP_HWBP_SET.  X = execute, i.e. call me at this address.
+ *
+ * KDBG_BP_W (a data watchpoint) is REFUSED by the kernel: the debug exception
+ * is taken before the access completes, this kernel does not single-step it,
+ * and the access therefore re-executes and traps forever - a storm that freezes
+ * the target, whose only escape is skipping the access, which corrupts it.
+ * Use a page watch (KDBG_OP_WATCH_*) to find out who touches memory. */
+#define KDBG_BP_X	0
+#define KDBG_BP_W	1
+
+#define KDBG_HBP_SLOTS	4
+
+/*
+ * Safety net.  An execute breakpoint traps *before* the instruction runs, so
+ * unless the kernel single-steps over it the CPU retries the same instruction
+ * and traps again - a livelock that pins a core.  In counting mode, after this
+ * many hits the handler skips the instruction once and stops being a loop.
+ */
+#define KDBG_HBP_TRIP	64
+
+/*
+ * What the breakpoint handler does when it fires.
+ *
+ * The four that act all leave the pc somewhere else on purpose: an action that
+ * left pc alone would trip again on the same instruction and never get out.
+ * Nothing here needs a trampoline, so nothing here copies the game's code.
+ */
+/*
+ * KDBG_ACT_NONE is also REFUSED: counting needs the instruction to execute
+ * again after the trap, which is the same storm.  There is no safe way to count
+ * hits without single-stepping, so an action is mandatory.
+ */
+#define KDBG_ACT_NONE	0	/* refused - see above */
+#define KDBG_ACT_SKIP	1	/* pc += 4 - the instruction does not run  */
+#define KDBG_ACT_RET	2	/* return from the function: pc = x30,
+				   x0 = value.  A function that answers
+				   "yes" forever costs not one byte.        */
+#define KDBG_ACT_PC	3	/* pc = value                              */
+#define KDBG_ACT_X0	4	/* x0 = value, then skip that instruction  */
+#define KDBG_ACT_REG	5	/* regs[reg] = value, then skip it         */
+
+/* KDBG_OP_WATCH_ARM modes. */
+#define KDBG_WATCH_WRITE	0	/* next write to the page			*/
+#define KDBG_WATCH_ACCESS	1	/* next read, write or execute		*/
+
+#define KDBG_WATCH_SLOTS	4
+
+#define KDBG_MAX_XFER		(1024 * 1024)
+
+/* kdbg_watch_info.flags */
+#define KDBG_WF_ARMED	0x0001
+#define KDBG_WF_SPENT	0x0002
+#define KDBG_WF_WRITE	0x0004	/* the access that fired was a write	*/
+#define KDBG_WF_ACCESS	0x0008	/* armed in ACCESS mode			*/
+
+struct kdbg_hbp_cfg {
+	int		pid;
+	unsigned long	type;
+	unsigned long	addr;
+	unsigned long	len;
+	unsigned long	action;
+	unsigned long	value;
+	unsigned long	reg;
+};
+
+struct kdbg_watch_cfg {
+	int		pid;
+	unsigned long	addr;
+	unsigned long	mode;
+};
+
+struct kdbg_watch_info {
+	unsigned long long	hits;
+	unsigned long long	last_pc;
+	unsigned long long	last_task;
+	unsigned long		addr;
+	unsigned long		flags;
+};
+
+/* What kdbg_syscall.c holds and calls. */
+typedef long (*kdbg_handler_t)(unsigned long op, unsigned long a1,
+			       unsigned long a2, unsigned long a3,
+			       unsigned long a4);
+
+/* Implemented in kdbg_syscall.c.  kdbg_core.c has to register itself through
+ * this, so it needs the prototype - which it did not have, and this tree builds
+ * with -Werror=implicit-function-declaration. */
+void kdbg_set_handler(kdbg_handler_t fn);
+
+/* Implemented in kdbg_watch.c, which is built into the kernel, not the module:
+ * it needs the page-fault path and the core mm helpers. */
+int kdbg_watch_arm(pid_t pid, unsigned long addr, unsigned long mode);
+int kdbg_watch_off(unsigned long slot);
+int kdbg_watch_stat(unsigned long slot, struct kdbg_watch_info *out);
+void kdbg_watch_off_all(void);
+
+#endif /* _KDBG_H */
diff --git a/drivers/kdbg/kdbg_syscall.c b/drivers/kdbg/kdbg_syscall.c
new file mode 100644
--- /dev/null
+++ b/drivers/kdbg/kdbg_syscall.c
@@ -0,0 +1,63 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * The syscall front end.
+ *
+ * Its entire body is "call the registered handler". The table entry is emitted
+ * by the compiler at build time, so nothing here ever writes to sys_call_table
+ * - no set_memory_rw, no text poking, no rwxp page, and nothing for another
+ * hook to collide with.
+ *
+ * If no handler is installed (kdbg_core.ko not loaded) this returns -ENOSYS,
+ * which is what an unimplemented table slot returns anyway.
+ */
+#include <linux/kernel.h>
+#include <linux/syscalls.h>
+#include <linux/mutex.h>
+#include <linux/export.h>
+
+#include "kdbg.h"
+
+static kdbg_handler_t kdbg_handler __read_mostly;
+static DEFINE_MUTEX(kdbg_mutex);
+
+void kdbg_set_handler(kdbg_handler_t fn)
+{
+	mutex_lock(&kdbg_mutex);
+	kdbg_handler = fn;
+	mutex_unlock(&kdbg_mutex);
+}
+EXPORT_SYMBOL_GPL(kdbg_set_handler);
+
+SYSCALL_DEFINE6(kdbg, unsigned long, cookie, unsigned long, op,
+		unsigned long, a1, unsigned long, a2,
+		unsigned long, a3, unsigned long, a4)
+{
+	kdbg_handler_t fn;
+	long ret;
+
+	if (cookie != KDBG_COOKIE)
+		return -ENOSYS;
+
+	/*
+	 * The mutex is held across the call on purpose: it serialises two
+	 * concurrent callers, and it also means rmmod cannot free the module
+	 * while a call is still inside it (module_exit takes the same lock to
+	 * clear the handler).
+	 */
+	mutex_lock(&kdbg_mutex);
+	fn = kdbg_handler;
+	ret = fn ? fn(op, a1, a2, a3, a4) : -ENOSYS;
+	mutex_unlock(&kdbg_mutex);
+
+	return ret;
+}
diff --git a/drivers/kdbg/kdbg_watch.c b/drivers/kdbg/kdbg_watch.c
new file mode 100644
--- /dev/null
+++ b/drivers/kdbg/kdbg_watch.c
@@ -0,0 +1,372 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Page watches - the fault-path half of a PTE hook.
+ *
+ * This file is built into the kernel, not into the module, because it needs two
+ * things a module cannot have: a call site inside do_page_fault() and the core
+ * mm helpers that manipulate another process's page tables.
+ *
+ * How it works, and why it is the safe end of "PTE hook":
+ *
+ *   1. Arming takes access to one page away from one process.  For a write
+ *      watch that means clearing the write bit in the PTE; for an access watch
+ *      it means clearing the PTE so the next touch faults.  Either way only the
+ *      page TABLE is touched.  The page's contents are untouched, so a scanner
+ *      that reads the memory finds exactly the original bytes - there is no
+ *      shadow page and no patched instruction anywhere.
+ *
+ *   2. The next time that process touches the page it faults, do_page_fault()
+ *      calls us before the normal handling, and we record the pc it faulted
+ *      from, which task it was, and whether it was a write.
+ *
+ *   3. We then put the PTE back the way it was and return "not handled", so the
+ *      normal fault path resolves it and the access simply succeeds.  Nothing
+ *      is emulated and no instruction is decoded - which is the whole trick.
+ *      A watch is single shot: one arm, one event.  Arm it again for another.
+ *
+ * What this deliberately does NOT do yet: substitute a different value for the
+ * game to read.  That needs either a shadow page (the page then belongs to the
+ * file's page cache, which is a real hazard) or decoding the faulting
+ * instruction.  Both are separate steps that want this watcher proven first.
+ */
+#include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mm.h>
+#include <linux/sched.h>
+#include <linux/sched/mm.h>
+#include <linux/pid.h>
+#include <linux/export.h>
+#include <linux/spinlock.h>
+#include <linux/jump_label.h>
+#include <linux/rmap.h>
+#include <linux/pagemap.h>
+#include <linux/mmap_lock.h>
+#include <asm/pgtable.h>
+#include <asm/tlbflush.h>
+#include <asm/ptrace.h>
+#include <asm/esr.h>
+
+#include <linux/kdbg.h>	/* so our definition is checked against the
+				 * prototype fault.c calls us through */
+
+#include "kdbg.h"
+
+/*
+ * Off unless something is armed.  A static branch compiles to a no-op that the
+ * CPU predicts perfectly, so do_page_fault() pays nothing for the call below
+ * while no watch exists.
+ */
+DEFINE_STATIC_KEY_FALSE(kdbg_watch_key);
+
+struct kdbg_watch_slot {
+	struct mm_struct	*mm;		/* NULL = free */
+	unsigned long		addr;		/* page aligned */
+	unsigned long		mode;
+	unsigned long long	hits;
+	unsigned long		last_pc;
+	unsigned long		last_task;
+	unsigned long		last_addr;
+	unsigned long		flags;
+};
+
+static struct kdbg_watch_slot kdbg_watch[KDBG_WATCH_SLOTS];
+static int kdbg_watch_live;
+
+/* ------------------------------------------------------------- page table */
+
+struct kdbg_pte {
+	pmd_t		*pmd;
+	pte_t		*ptep;
+	spinlock_t	*ptl;
+};
+
+/*
+ * Walk to the PTE for addr.  Caller must hold mmap_sem for read.  Returns
+ * 0 with ptep locked, or an error with nothing held.
+ */
+static int kdbg_pte_lock(struct mm_struct *mm, unsigned long addr,
+			 struct kdbg_pte *out)
+{
+	pgd_t *pgd;
+	pud_t *pud;
+	pmd_t *pmd;
+
+	pgd = pgd_offset(mm, addr);
+	if (pgd_none(*pgd) || pgd_bad(*pgd))
+		return -EFAULT;
+
+	pud = pud_offset(pgd, addr);
+	if (pud_none(*pud) || pud_bad(*pud))
+		return -EFAULT;
+
+	pmd = pmd_offset(pud, addr);
+	if (pmd_none(*pmd) || pmd_bad(*pmd))
+		return -EFAULT;
+
+	/* A huge mapping has no PTE to take access from.  (No pmd_devmap
+	 * here: this tree has not got it.) */
+	if (pmd_trans_huge(*pmd))
+		return -EOPNOTSUPP;
+
+	out->pmd  = pmd;
+	out->ptep = pte_offset_map_lock(mm, pmd, addr, &out->ptl);
+	if (!out->ptep) {
+		out->ptl = NULL;
+		return -EFAULT;
+	}
+	return 0;
+}
+
+static void kdbg_pte_unlock(struct kdbg_pte *p)
+{
+	if (p->ptep)
+		pte_unmap_unlock(p->ptep, p->ptl);
+}
+
+/* ---------------------------------------------------------------- arming */
+
+int kdbg_watch_arm(pid_t pid, unsigned long addr, unsigned long mode)
+{
+	struct kdbg_watch_slot *w = NULL;
+	struct task_struct *t;
+	struct mm_struct *mm;
+	struct vm_area_struct *vma;
+	struct kdbg_pte p = { NULL, NULL, NULL };
+	unsigned long pgaddr = addr & PAGE_MASK;
+	pte_t pte, new;
+	int slot, ret;
+
+	if (mode != KDBG_WATCH_WRITE && mode != KDBG_WATCH_ACCESS)
+		return -EINVAL;
+
+	for (slot = 0; slot < KDBG_WATCH_SLOTS; slot++)
+		if (!kdbg_watch[slot].mm) {
+			w = &kdbg_watch[slot];
+			break;
+		}
+	if (!w)
+		return -ENOSPC;
+
+	rcu_read_lock();
+	t = find_task_by_vpid(pid);
+	if (t)
+		get_task_struct(t);
+	rcu_read_unlock();
+	if (!t)
+		return -ESRCH;
+
+	/* get_task_mm returns with a reference held; we keep it until disarm. */
+	mm = get_task_mm(t);
+	put_task_struct(t);
+	if (!mm)
+		return -EINVAL;
+
+	mmap_read_lock(mm);
+
+	vma = find_vma(mm, addr);
+	if (!vma || vma->vm_start > addr) {
+		ret = -ENOENT;
+		goto out_unlock;
+	}
+
+	ret = kdbg_pte_lock(mm, addr, &p);
+	if (ret)
+		goto out_unlock;
+
+	pte = *p.ptep;
+	if (!pte_present(pte)) {
+		/* Not faulted in yet - there is no access to take away. */
+		ret = -EFAULT;
+		goto out_pte;
+	}
+
+	new = pte;
+	if (mode == KDBG_WATCH_WRITE) {
+		/*
+		 * Safe on anything: clearing the write bit is exactly what
+		 * copy-on-write does, and the page is not lost, only made
+		 * read-only until the next write faults.
+		 */
+		new = pte_wrprotect(pte);
+	} else {
+		/*
+		 * Clearing the PTE means the normal fault path has to rebuild it
+		 * from the VMA, so it must be a clean file page.  On a writable
+		 * pte that rebuild would throw away a private copy, and on an
+		 * anonymous page there is nothing to rebuild from at all.
+		 */
+		if (!vma->vm_file || pte_write(pte)) {
+			ret = -EOPNOTSUPP;
+			goto out_pte;
+		}
+	}
+
+	w->addr = pgaddr;
+	w->mode = mode;
+	w->hits = 0;
+	w->last_pc = 0;
+	w->last_task = 0;
+	w->last_addr = 0;
+	w->flags = KDBG_WF_ARMED;
+	if (mode == KDBG_WATCH_ACCESS)
+		w->flags |= KDBG_WF_ACCESS;
+
+	if (mode == KDBG_WATCH_WRITE)
+		set_pte_at(mm, addr, p.ptep, new);
+	else
+		ptep_get_and_clear(mm, addr, p.ptep);
+
+	kdbg_pte_unlock(&p);
+	mmap_read_unlock(mm);
+
+	/*
+	 * The PTE changed, so every CPU that might have it cached has to be
+	 * told.  Safe here - process context, no spinlock held.
+	 */
+	flush_tlb_mm(mm);
+
+	if (kdbg_watch_live++ == 0)
+		static_branch_enable(&kdbg_watch_key);
+
+	/* Published last: the fault path keys off w->mm. */
+	smp_wmb();
+	w->mm = mm;
+
+	return slot;
+
+out_pte:
+	kdbg_pte_unlock(&p);
+out_unlock:
+	mmap_read_unlock(mm);
+	mmput(mm);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(kdbg_watch_arm);
+
+/* -------------------------------------------------------------- restoring */
+
+/*
+ * The fault-path entry.  Never claims the fault: it records, puts the page back
+ * the way it was, and returns so the normal handling goes ahead and the access
+ * succeeds.  Nothing here can fail the target's access.
+ */
+int kdbg_watch_fault(struct pt_regs *regs, unsigned long addr, unsigned int esr)
+{
+	struct mm_struct *mm;
+	struct kdbg_watch_slot *w;
+	unsigned long flags;
+	int i;
+
+	if (!static_branch_unlikely(&kdbg_watch_key))
+		return 0;
+
+	mm = current->mm;
+	if (!mm)
+		return 0;
+
+	for (i = 0; i < KDBG_WATCH_SLOTS; i++) {
+		w = &kdbg_watch[i];
+		if (w->mm != mm)
+			continue;
+
+		flags = READ_ONCE(w->flags);
+		if (!(flags & KDBG_WF_ARMED))
+			continue;
+		if ((addr & PAGE_MASK) != w->addr)
+			continue;
+
+		/*
+		 * Take the slot first: a second CPU faulting on the same page
+		 * must not record a second, phantom event.
+		 */
+		WRITE_ONCE(w->flags, flags | KDBG_WF_SPENT);
+
+		w->hits++;
+		w->last_pc = regs ? regs->pc : 0;
+		w->last_task = current->tgid;
+		w->last_addr = addr;
+		if (esr & ESR_ELx_WNR)
+			WRITE_ONCE(w->flags, READ_ONCE(w->flags) | KDBG_WF_WRITE);
+
+		/*
+		 * That is all.  No page table work, no TLB shootdown, no lock
+		 * beyond the ones the fault path already holds - which is the
+		 * whole point.  The page is still write-protected, so the
+		 * retried write faults once more, finds this slot spent, and
+		 * the normal fault path installs a proper PTE itself.
+		 */
+		return 0;
+	}
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(kdbg_watch_fault);
+
+/* ---------------------------------------------------------------- disarm */
+
+int kdbg_watch_off(unsigned long slot)
+{
+	struct kdbg_watch_slot *w;
+	struct mm_struct *mm;
+
+	if (slot >= KDBG_WATCH_SLOTS)
+		return -EINVAL;
+
+	w = &kdbg_watch[slot];
+	if (!w->mm)
+		return -EINVAL;
+
+	mm = w->mm;
+
+	/*
+	 * Nothing to put back.  Arming only took the write bit away, and the
+	 * target's own first write to that page faults straight into the normal
+	 * path, which installs a correct PTE by itself.  So this deliberately
+	 * writes no page table at all: an unload must not be able to alter a
+	 * live process, and an "unfreeze" must not be able to wait on anything.
+	 */
+
+	WRITE_ONCE(w->flags, 0);
+	smp_wmb();
+	w->mm = NULL;
+	mmput(mm);
+
+	if (kdbg_watch_live > 0 && --kdbg_watch_live == 0)
+		static_branch_disable(&kdbg_watch_key);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(kdbg_watch_off);
+
+/*
+ * Release every slot.  Called from module_exit: the watches live in this
+ * built-in file, not in the module, so without this an rmmod would leave pages
+ * write-protected and the fault hook still firing - the module would look like
+ * the cause of a freeze it can no longer clear.
+ */
+void kdbg_watch_off_all(void)
+{
+	int i;
+
+	for (i = 0; i < KDBG_WATCH_SLOTS; i++)
+		if (kdbg_watch[i].mm)
+			kdbg_watch_off(i);
+}
+EXPORT_SYMBOL_GPL(kdbg_watch_off_all);
+
+int kdbg_watch_stat(unsigned long slot, struct kdbg_watch_info *out)
+{
+	struct kdbg_watch_slot *w;
+
+	if (slot >= KDBG_WATCH_SLOTS)
+		return -EINVAL;
+
+	w = &kdbg_watch[slot];
+	if (!w->mm)
+		return -EINVAL;
+
+	out->hits      = w->hits;
+	out->last_pc   = w->last_pc;
+	out->last_task = w->last_task;
+	out->addr      = w->addr;
+	out->flags     = READ_ONCE(w->flags);
+
+	return 0;
+}
+EXPORT_SYMBOL_GPL(kdbg_watch_stat);
