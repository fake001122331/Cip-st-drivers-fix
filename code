+// SPDX-License-Identifier: GPL-2.0
+/*
+ * kdbg core - everything that actually touches memory.
+ *
+ * There is no device node, no proc entry, no sysfs attribute and not one
+ * printk: logcat is one of the few channels the anti-cheat really does read,
+ * so this module never says anything.
+ *
+ * Reads and writes map the target's own pages and copy straight between them
+ * and the caller.  No staging buffer, so a bulk read costs one copy instead of
+ * two, and none of the userspace checks apply - no VMA permission test, no
+ * ptrace_may_access, no SELinux.  Writes break copy-on-write the same way
+ * /proc/<pid>/mem does, so a read-only mapping can be written too.
+ */
+#include <linux/kernel.h>
+#include <linux/sched.h>
+#include <linux/sched/mm.h>
+#include <linux/mm.h>
+#include <linux/pid.h>
+#include <linux/uaccess.h>
+#include <linux/slab.h>
+#include <linux/rcupdate.h>
+#include <linux/fs.h>
+#include <linux/dcache.h>
+#include <linux/module.h>
+#include <linux/miscdevice.h>
+#include <linux/proc_fs.h>
+#include <linux/string.h>
+#include <linux/perf_event.h>
+#include <linux/hw_breakpoint.h>
+#include <linux/pagemap.h>
+#include <linux/mmap_lock.h>
+#include <linux/highmem.h>
+
+#include "kdbg.h"
+
+/*
+ * 1 = also answer as a device node the wanbai.h family of clients can find
+ * (see the block below).  0 = syscall only, no nodes.
+ */
+#define KDBG_COMPAT	1
+
+/*
+ * find_task_by_vpid() is NOT exported to modules, and this file is a module -
+ * modpost refuses the link over it.  find_get_pid() and get_pid_task() are both
+ * EXPORT_SYMBOL_GPL, and get_pid_task() hands back a task reference, which is
+ * exactly what the rcu_read_lock + get_task_struct dance was doing by hand.
+ *
+ * (The built-in half, kdbg_watch.c, keeps using find_task_by_vpid(): built-in
+ * code may use unexported symbols, and it is already proven to link.)
+ */
+static struct task_struct *kdbg_get_task(pid_t pid)
+{
+	struct pid *p;
+	struct task_struct *t;
+
+	p = find_get_pid(pid);
+	if (!p)
+		return NULL;
+
+	t = get_pid_task(p, PIDTYPE_PID);
+	put_pid(p);
+
+	return t;
+}
+
+/* ------------------------------------------------------- bulk memory, no buffer */
+
+/*
+ * Pages are mapped in batches and copied straight to and from the caller, so a
+ * transfer costs one copy rather than the two a staging buffer would.
+ *
+ * get_user_pages_remote() is the same primitive a driver uses to pin a user
+ * buffer; pointed at another process's mm it pins that process's pages.
+ * FOLL_FORCE is what makes a write into a read-only mapping work: it breaks
+ * copy-on-write rather than refusing.
+ */
+#define KDBG_BATCH	32
+
+static long kdbg_rw(pid_t pid, unsigned long addr, void __user *ubuf,
+		    unsigned long len, bool write)
+{
+	struct page *pages[KDBG_BATCH];
+	struct task_struct *t;
+	struct mm_struct *mm;
+	unsigned long done = 0;
+	unsigned int gup_flags = FOLL_FORCE;
+	int ret = 0;
+
+	if (!len || len > KDBG_MAX_XFER || !ubuf)
+		return -EINVAL;
+
+	t = kdbg_get_task(pid);
+	if (!t)
+		return -ESRCH;
+	mm = get_task_mm(t);
+	if (!mm) {
+		put_task_struct(t);
+		return -EINVAL;
+	}
+
+	if (write)
+		gup_flags |= FOLL_WRITE;
+
+	while (done < len) {
+		unsigned long chunk = min_t(unsigned long, len - done,
+					    (unsigned long)KDBG_BATCH * PAGE_SIZE);
+		int npages, i;
+		unsigned long off = 0;
+
+		npages = get_user_pages_remote(t, mm, addr + done,
+					       DIV_ROUND_UP(chunk, PAGE_SIZE),
+					       gup_flags, pages, NULL, NULL);
+		if (npages <= 0) {
+			ret = npages ? npages : -EFAULT;
+			break;
+		}
+
+		for (i = 0; i < npages && off < chunk; i++) {
+			unsigned long poff = (addr + done + off) & ~PAGE_MASK;
+			unsigned long n = min_t(unsigned long, PAGE_SIZE - poff,
+						chunk - off);
+			void *kaddr = kmap(pages[i]);
+
+			if (!kaddr) {
+				ret = -EFAULT;
+				break;
+			}
+
+			if (write) {
+				if (copy_from_user(kaddr + poff, ubuf + done + off, n)) {
+					kunmap(pages[i]);
+					ret = -EFAULT;
+					break;
+				}
+				set_page_dirty_lock(pages[i]);
+			} else if (copy_to_user(ubuf + done + off, kaddr + poff, n)) {
+				kunmap(pages[i]);
+				ret = -EFAULT;
+				break;
+			}
+
+			kunmap(pages[i]);
+			off += n;
+		}
+
+		for (i = 0; i < npages; i++)
+			put_page(pages[i]);
+
+		if (ret)
+			break;
+
+		done += off;
+		if (off < chunk)
+			break;		/* short mapping - nothing more to reach */
+	}
+
+	mmput(mm);
+	put_task_struct(t);
+
+	if (ret && !done)
+		return ret;
+	return done;
+}
+
+/* ------------------------------------------------------------ module base */
+
+/*
+ * Lowest mapping of a shared object, i.e. its load base.  Walked from the
+ * target's own mm rather than from /proc/<pid>/maps, so it works even if the
+ * map file is closed off.
+ */
+static long kdbg_find_base(pid_t pid, const char __user *uname, unsigned long *out)
+{
+	struct task_struct *t;
+	struct mm_struct *mm;
+	struct vm_area_struct *vma;
+	char name[64];
+	unsigned long base = 0;
+	size_t nlen;
+
+	if (copy_from_user(name, uname, sizeof(name)))
+		return -EFAULT;
+	name[sizeof(name) - 1] = '\0';
+	nlen = strlen(name);
+	if (!nlen)
+		return -EINVAL;
+
+	t = kdbg_get_task(pid);
+	if (!t)
+		return -ESRCH;
+	mm = get_task_mm(t);
+	put_task_struct(t);
+	if (!mm)
+		return -EINVAL;
+
+	mmap_read_lock(mm);
+	for (vma = mm->mmap; vma; vma = vma->vm_next) {
+		const struct qstr *q;
+		int hit;
+
+		if (!vma->vm_file)
+			continue;
+
+		rcu_read_lock();
+		q = &vma->vm_file->f_path.dentry->d_name;
+		hit = q->len == nlen && !memcmp(q->name, name, nlen);
+		rcu_read_unlock();
+
+		if (hit) {
+			base = vma->vm_start;	/* mmap is address-ordered */
+			break;
+		}
+	}
+	mmap_read_unlock(mm);
+	mmput(mm);
+
+	if (!base)
+		return -ENOENT;
+	*out = base;
+
+	return 0;
+}
+
+/* ------------------------------------------------------ hardware breakpoints */
+
+#ifdef CONFIG_HAVE_HW_BREAKPOINT
+/*
+ * Hardware breakpoints - the reason a kernel side is worth having.
+ *
+ * Nothing about the target changes.  The address goes into one of the four
+ * debug registers, and the CPU tells us when it gets there.  There is no
+ * patched byte, no page made writable, no trampoline and no leftover rwxp
+ * mapping, so there is nothing to find by comparing the process against a
+ * clean copy of itself - and nothing that survives the game being restarted.
+ *
+ * The handler runs in debug-exception context: no sleeping, no locks, no
+ * allocation.  It counts, remembers the pc, and does what the slot was armed
+ * to do.
+ */
+struct kdbg_hbp {
+	struct perf_event	*bp;
+	unsigned long		addr;
+	unsigned long long	hits;
+	unsigned long		last_pc;
+	unsigned long long	spent;
+	unsigned long		action;
+	unsigned long		value;
+	unsigned long		reg;
+};
+
+static struct kdbg_hbp kdbg_hbp[KDBG_HBP_SLOTS];
+
+static void kdbg_hbp_triggered(struct perf_event *bp,
+			       struct perf_sample_data *data,
+			       struct pt_regs *regs)
+{
+	struct kdbg_hbp *h = bp->overflow_handler_context;
+
+	if (!h)
+		return;
+
+	h->hits++;
+	if (regs)
+		h->last_pc = regs->pc;
+
+	if (h->action == KDBG_ACT_NONE) {
+		/*
+		 * Counting mode.  An execute breakpoint traps before the
+		 * instruction runs, so if the kernel does not single-step it
+		 * the CPU retries and traps again; after KDBG_HBP_TRIP hits we
+		 * skip it once.  That derails at most the thread that tripped
+		 * it, where letting it spin would take the core with it.
+		 */
+		if (h->hits == KDBG_HBP_TRIP && regs) {
+			regs->pc += 4;
+			h->spent = 1;
+		}
+		return;
+	}
+
+	if (!regs)
+		return;
+
+	/*
+	 * Every action below leaves pc somewhere other than this address.
+	 * One that did not would trip again on the same instruction and never
+	 * get out - which is why there is no "set the register and carry on".
+	 */
+	switch (h->action) {
+	case KDBG_ACT_SKIP:
+		regs->pc += 4;
+		break;
+	case KDBG_ACT_RET:
+		/* Return from the function now, answering with `value`. */
+		regs->pc = regs->regs[30];
+		regs->regs[0] = h->value;
+		break;
+	case KDBG_ACT_PC:
+		regs->pc = h->value;
+		break;
+	case KDBG_ACT_X0:
+		regs->regs[0] = h->value;
+		regs->pc += 4;
+		break;
+	case KDBG_ACT_REG:
+		if (h->reg < 31)
+			regs->regs[h->reg] = h->value;
+		regs->pc += 4;
+		break;
+	}
+}
+
+static long kdbg_hbp_set(pid_t pid, unsigned long addr, unsigned long type,
+			 unsigned long len, unsigned long action,
+			 unsigned long value, unsigned long reg)
+{
+	struct perf_event_attr attr;
+	struct task_struct *t;
+	struct perf_event *bp;
+	int slot;
+
+	/*
+	 * A data watchpoint is refused outright, and so is counting mode.
+	 *
+	 * A debug exception is taken BEFORE the access or the instruction
+	 * completes.  This kernel does not single-step it for us on the way out,
+	 * so the CPU retries the same access, traps again, and never gets
+	 * anywhere - a trap storm on that thread that freezes the process.  The
+	 * earlier version "solved" that by skipping the instruction after 64
+	 * hits, which for a store means the store never happens and the target's
+	 * frame is corrupted.  Both outcomes are worse than not arming.
+	 *
+	 * Only the actions survive, because every one of them moves pc: the
+	 * instruction is not retried, so nothing storms.  KDBG_ACT_RET is the
+	 * useful one - the function returns immediately with a chosen value, and
+	 * not one byte of it is ever written.
+	 *
+	 * To find out who touches what, use a page watch: the page table is
+	 * written, the page's contents are not, nothing traps on the retry path,
+	 * and it reports the pc and the task.
+	 */
+	if (type == KDBG_BP_W)
+		return -EOPNOTSUPP;
+	if (action == KDBG_ACT_NONE)
+		return -EOPNOTSUPP;
+
+	for (slot = 0; slot < KDBG_HBP_SLOTS; slot++)
+		if (!kdbg_hbp[slot].bp)
+			break;
+	if (slot == KDBG_HBP_SLOTS)
+		return -ENOSPC;
+
+	t = kdbg_get_task(pid);
+	if (!t)
+		return -ESRCH;
+
+	hw_breakpoint_init(&attr);
+	attr.bp_addr = addr;
+	attr.bp_len  = len ? len : HW_BREAKPOINT_LEN_4;
+	attr.bp_type = type ? HW_BREAKPOINT_W : HW_BREAKPOINT_X;
+
+	bp = register_user_hw_breakpoint(&attr, kdbg_hbp_triggered,
+					 &kdbg_hbp[slot], t);
+	put_task_struct(t);
+
+	if (IS_ERR(bp))
+		return PTR_ERR(bp);
+
+	kdbg_hbp[slot].bp      = bp;
+	kdbg_hbp[slot].addr    = addr;
+	kdbg_hbp[slot].hits    = 0;
+	kdbg_hbp[slot].last_pc = 0;
+	kdbg_hbp[slot].spent   = 0;
+	kdbg_hbp[slot].action  = action;
+	kdbg_hbp[slot].value   = value;
+	kdbg_hbp[slot].reg     = reg;
+
+	return slot;
+}
+
+static long kdbg_hbp_del(unsigned long slot)
+{
+	if (slot >= KDBG_HBP_SLOTS || !kdbg_hbp[slot].bp)
+		return -EINVAL;
+
+	unregister_hw_breakpoint(kdbg_hbp[slot].bp);
+	kdbg_hbp[slot].bp = NULL;
+
+	return 0;
+}
+
+static long kdbg_hbp_stat(unsigned long slot, unsigned long __user *uout)
+{
+	u64 v[4];
+
+	if (slot >= KDBG_HBP_SLOTS || !kdbg_hbp[slot].bp)
+		return -EINVAL;
+
+	v[0] = kdbg_hbp[slot].hits;
+	v[1] = kdbg_hbp[slot].last_pc;
+	v[2] = kdbg_hbp[slot].spent;
+	v[3] = kdbg_hbp[slot].addr;
+
+	return copy_to_user(uout, v, sizeof(v)) ? -EFAULT : 0;
+}
+
+static void kdbg_hbp_cleanup(void)
+{
+	int slot;
+
+	for (slot = 0; slot < KDBG_HBP_SLOTS; slot++)
+		if (kdbg_hbp[slot].bp) {
+			unregister_hw_breakpoint(kdbg_hbp[slot].bp);
+			kdbg_hbp[slot].bp = NULL;
+		}
+}
+#else /* !CONFIG_HAVE_HW_BREAKPOINT */
+static void kdbg_hbp_cleanup(void) { }
+#endif /* CONFIG_HAVE_HW_BREAKPOINT */
+
+/* -------------------------------------------------------- wanbai.h compatibility */
+/*
+ * Compatibility with the wanbai.h family of clients.
+ *
+ * Those hacks do not know about us and never will: they open a device node
+ * and issue ioctl 0x800..0x803.
+ *
+ *   0x800  initKey, a per-build key string
+ *   0x801  {int pid; uintptr_t addr; void *buffer; size_t size;}
+ *   0x802  the same struct, writing
+ *   0x803  {int pid; char *name; uintptr_t base;}
+ *
+ * Those struct layouts are copied from their header, so the offsets match
+ * exactly.  One node per name they hunt for, plus a fake /proc entry for the
+ * rt-proc shape, lets an unmodified hack work against us by picking its own
+ * menu entry - nothing to recompile and nothing to rebuild.
+ *
+ * The key is accepted whatever it is.  We are not the build that minted it,
+ * and refusing an unknown key would only break the handshake.
+ *
+ * Set KDBG_COMPAT to 0 when you want no device nodes at all.
+ */
+#define KDBG_COMPAT_DEVS "wanbai,CheckMe,Ckanri,lanran,video188,bing"
+#define KDBG_COMPAT_PROC "kvmstats"
+
+#define KDBG_IOCTL_INIT_KEY	0x800
+#define KDBG_IOCTL_READ_MEM	0x801
+#define KDBG_IOCTL_WRITE_MEM	0x802
+#define KDBG_IOCTL_MODULE_BASE	0x803
+
+/*
+ * A second family, same idea and the same structs, different opcode range and
+ * different node names.  Answering it too costs one dispatch arm and makes the
+ * "option 7 / Bing" entry in a hack's menu work.
+ */
+#define KDBG_IOCTL_BING_KEY	0x100
+#define KDBG_IOCTL_BING_READ	0x101
+#define KDBG_IOCTL_BING_WRITE	0x102
+#define KDBG_IOCTL_BING_BASE	0x103
+
+struct kdbg_copy_memory {
+	pid_t		pid;
+	uintptr_t	addr;
+	void		*buffer;
+	size_t		size;
+};
+
+struct kdbg_module_base {
+	pid_t		pid;
+	char		*name;
+	uintptr_t	base;
+};
+
+static long kdbg_compat_ioctl(struct file *f, unsigned int cmd, unsigned long arg)
+{
+	void __user *uarg = (void __user *)arg;
+
+	switch (cmd) {
+	case KDBG_IOCTL_INIT_KEY:
+	case KDBG_IOCTL_BING_KEY:
+		/* any key, any length, even none */
+		return 0;
+
+	case KDBG_IOCTL_READ_MEM:
+	case KDBG_IOCTL_BING_READ: {
+		struct kdbg_copy_memory cm;
+		long r;
+
+		if (copy_from_user(&cm, uarg, sizeof(cm)))
+			return -EFAULT;
+		if (!cm.buffer || !cm.size)
+			return -EINVAL;
+
+		r = kdbg_rw(cm.pid, cm.addr, (void __user *)cm.buffer, cm.size, false);
+		return r == (long)cm.size ? 0 : (r < 0 ? r : -EFAULT);
+	}
+
+	case KDBG_IOCTL_WRITE_MEM:
+	case KDBG_IOCTL_BING_WRITE: {
+		struct kdbg_copy_memory cm;
+		long r;
+
+		if (copy_from_user(&cm, uarg, sizeof(cm)))
+			return -EFAULT;
+		if (!cm.buffer || !cm.size)
+			return -EINVAL;
+
+		r = kdbg_rw(cm.pid, cm.addr, (void __user *)cm.buffer, cm.size, true);
+		return r == (long)cm.size ? 0 : (r < 0 ? r : -EFAULT);
+	}
+
+	case KDBG_IOCTL_MODULE_BASE:
+	case KDBG_IOCTL_BING_BASE: {
+		struct kdbg_module_base mb;
+		unsigned long base = 0;
+		long r;
+
+		if (copy_from_user(&mb, uarg, sizeof(mb)))
+			return -EFAULT;
+		if (!mb.name)
+			return -EINVAL;
+
+		r = kdbg_find_base(mb.pid, (const char __user *)mb.name, &base);
+		if (r)
+			return r;
+		if (put_user(base, &((struct kdbg_module_base __user *)uarg)->base))
+			return -EFAULT;
+		return 0;
+	}
+
+	default:
+		return -ENOTTY;
+	}
+}
+
+static const struct file_operations kdbg_compat_fops = {
+	.owner		= THIS_MODULE,
+	.unlocked_ioctl	= kdbg_compat_ioctl,
+	.compat_ioctl	= kdbg_compat_ioctl,
+};
+
+#define KDBG_COMPAT_MAX	8
+
+/*
+ * 0 = do not create the device nodes at load.  They are the only part of this
+ * driver that is visible to every process, so the default is nothing; a session
+ * that needs them asks for them, either with `insmod ... compat=1` or with the
+ * KDBG_OP_COMPAT syscall at runtime.
+ */
+#ifdef MODULE
+static int kdbg_compat;
+module_param(kdbg_compat, int, 0644);
+MODULE_PARM_DESC(kdbg_compat, "register the wanbai/bing device nodes at load (0/1)");
+#else
+static int kdbg_compat;	/* built in: no parameter, so no /sys/module entry */
+#endif
+
+static struct miscdevice kdbg_misc[KDBG_COMPAT_MAX];
+static char kdbg_misc_name[KDBG_COMPAT_MAX][32];
+static int kdbg_misc_n;
+static struct proc_dir_entry *kdbg_proc;
+
+static int kdbg_compat_init(void)
+{
+	char list[160];
+	char *p = list;
+	char *tok;
+	int i;
+
+	if (kdbg_misc_n || kdbg_proc)
+		return kdbg_misc_n;	/* already up */
+
+	/* miscdevice.name has to outlive this call, hence the static copies */
+	strlcpy(list, KDBG_COMPAT_DEVS, sizeof(list));
+
+	while (p && *p && kdbg_misc_n < KDBG_COMPAT_MAX) {
+		tok = strsep(&p, ",");
+		if (!tok || !*tok)
+			continue;
+
+		for (i = 0; i < kdbg_misc_n; i++)
+			if (!strcmp(kdbg_misc_name[i], tok))
+				break;
+		if (i < kdbg_misc_n)
+			continue;
+
+		strlcpy(kdbg_misc_name[kdbg_misc_n], tok, 32);
+		kdbg_misc[kdbg_misc_n].name  = kdbg_misc_name[kdbg_misc_n];
+		kdbg_misc[kdbg_misc_n].minor = MISC_DYNAMIC_MINOR;
+		kdbg_misc[kdbg_misc_n].fops  = &kdbg_compat_fops;
+		kdbg_misc[kdbg_misc_n].mode  = 0666;
+
+		if (misc_register(&kdbg_misc[kdbg_misc_n]))
+			continue;
+
+		kdbg_misc_n++;
+	}
+
+	kdbg_proc = proc_create(KDBG_COMPAT_PROC, 0666, NULL, &kdbg_compat_fops);
+
+	return 0;
+}
+
+static void kdbg_compat_cleanup(void)
+{
+	int i;
+
+	if (kdbg_proc) {
+		remove_proc_entry(KDBG_COMPAT_PROC, NULL);
+		kdbg_proc = NULL;
+	}
+
+	for (i = 0; i < kdbg_misc_n; i++)
+		misc_deregister(&kdbg_misc[i]);
+	kdbg_misc_n = 0;
+}
+
+/* ------------------------------------------------------------------ dispatch */
+
+static long kdbg_dispatch(unsigned long op, unsigned long a1, unsigned long a2,
+			  unsigned long a3, unsigned long a4)
+{
+	switch (op) {
+	case KDBG_OP_PING:
+		return KDBG_MAGIC;
+
+	case KDBG_OP_READ:
+		return kdbg_rw((pid_t)a1, a2, (void __user *)a3, a4, false);
+	case KDBG_OP_WRITE:
+		return kdbg_rw((pid_t)a1, a2, (void __user *)a3, a4, true);
+
+	case KDBG_OP_BASE: {
+		unsigned long b = 0;
+		long r = kdbg_find_base((pid_t)a1, (const char __user *)a2, &b);
+
+		if (r)
+			return r;
+		return put_user(b, (unsigned long __user *)a3) ? -EFAULT : 0;
+	}
+
+	case KDBG_OP_HWBP_SET:
+	case KDBG_OP_HWBP_DEL:
+	case KDBG_OP_HWBP_STAT:
+	case KDBG_OP_HWBP_ARM:
+#ifdef CONFIG_HAVE_HW_BREAKPOINT
+		if (op == KDBG_OP_HWBP_SET)
+			return kdbg_hbp_set((pid_t)a1, a2, a3, a4,
+					    KDBG_ACT_NONE, 0, 0);
+		if (op == KDBG_OP_HWBP_ARM) {
+			struct kdbg_hbp_cfg cfg;
+
+			if (copy_from_user(&cfg, (void __user *)a1, sizeof(cfg)))
+				return -EFAULT;
+			return kdbg_hbp_set(cfg.pid, cfg.addr, cfg.type, cfg.len,
+					    cfg.action, cfg.value, cfg.reg);
+		}
+		if (op == KDBG_OP_HWBP_DEL)
+			return kdbg_hbp_del(a1);
+		return kdbg_hbp_stat(a1, (unsigned long __user *)a2);
+#else
+		return -EOPNOTSUPP;
+#endif
+
+	case KDBG_OP_WATCH_ARM:
+		return kdbg_watch_arm((pid_t)a1, a2, a3);
+
+	case KDBG_OP_WATCH_STAT: {
+		struct kdbg_watch_info info;
+		long r = kdbg_watch_stat(a1, &info);
+
+		if (r)
+			return r;
+		return copy_to_user((void __user *)a2, &info, sizeof(info))
+			? -EFAULT : 0;
+	}
+
+	case KDBG_OP_WATCH_OFF:
+		return kdbg_watch_off(a1);
+
+	case KDBG_OP_COMPAT:
+		if (a1)
+			return kdbg_compat_init();
+		kdbg_compat_cleanup();
+		return 0;
+
+	default:
+		return -EINVAL;
+	}
+}
+
+static int __init kdbg_core_init(void)
+{
+	kdbg_set_handler(kdbg_dispatch);
+	if (kdbg_compat)
+		kdbg_compat_init();
+	return 0;
+}
+
+#ifdef MODULE
+static void __exit kdbg_core_exit(void)
+{
+	kdbg_compat_cleanup();
+	kdbg_hbp_cleanup();
+	kdbg_watch_off_all();	/* pages go back to normal before we leave */
+	kdbg_set_handler(NULL);
+}
+
+module_init(kdbg_core_init);
+module_exit(kdbg_core_exit);
+MODULE_LICENSE("GPL");
+MODULE_DESCRIPTION("kdbg core");
+#else
+late_initcall(kdbg_core_init);
+#endif